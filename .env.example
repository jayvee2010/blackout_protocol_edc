# GOOGLE SHEETS LEADERBOARD CONFIGURATION (RECOMMENDED & AUTOMATIC)
# Follow the quick 3-step setup in google-sheets-script.js:
# 1. Open Google Sheets (https://sheets.new) -> Extensions -> Apps Script
# 2. Paste google-sheets-script.js -> Deploy -> New deployment -> Web app -> Access: Anyone
# 3. Paste your Web App URL below:
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/your-deployment-id/exec

# OPTIONAL: SUPABASE DEPLOYMENT CONFIGURATION
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
